{
    "name": "siimit",
    "version": "1.1.7",
    "description": "A CLI for submitting GPU training jobs.",
    "type": "module",
    "private": true,
    "author": {
        "name": "MugeTong",
        "email": "here5320@gmail.com"
    },
    "license": "MIT",
    "readme": "README.md",
    "bin": "./src/index.ts",
    "scripts": {
        "dev": "bun run src/index.ts",
        "test": "bun test",
        "build:all": "bun run build:linux && bun run build:darwin",
        "build:linux": "bun build --compile --minify --target bun-linux-x64 src/index.ts --outfile dist/siimit-linux-x64",
        "build:darwin": "bun build --compile --minify --target bun-darwin-arm64 src/index.ts --outfile dist/siimit-darwin-arm64",
        "package": "xz -3 -f dist/siimit-linux-x64 dist/siimit-darwin-arm64",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "install-local": "bash scripts/install-local.sh"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "console-table-printer": "^2.16.1"
    }
}
