{
  "name": "siimit",
  "version": "1.0.1",
  "description": "A CLI for submitting GPU training jobs.",
  "type": "module",
  "private": true,
  "author": {
    "name": "MugeTong",
    "email": "here5320@gmail.com"
  },
  "license": "MIT",
  "readme": "README.md",
  "bin": "./src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build --compile --minify --target bun-linux-x64 src/index.ts --outfile dist/siimit-linux-x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-local": "bun run build && bash scripts/install-local.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "cli-table3": "^0.6.5"
  }
}
